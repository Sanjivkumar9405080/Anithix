# ANTHIX Backend Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Local: mongodb://127.0.0.1:27017/anthix
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/anthix?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Frontend Client URL (For CORS and redirect validation)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication & Session Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=anthix_session

# SMTP Email Service Configuration (e.g., Gmail, SendGrid, Mailgun, Brevo, AWS SES)
# Leave empty in development to use the safe development mock logger
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username@example.com
EMAIL_PASS=your_smtp_password_or_app_password
EMAIL_FROM=ANTHIX Security <no-reply@anthix.com>

# OTP Security Policies
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
